// Puts the upper USB 3 port (dwc3_0) of the Radxa ROCK 4C+ in device mode,
// so it can be the car's drive. From the teslausb wiki, where it works
// with Armbian on this board:
// https://github.com/marcone/teslausb/wiki/Rock-Pi-4C-plus-Installation
/dts-v1/;
/plugin/;

/ {
	compatible = "rockchip,rk3399";

	fragment@0 {
		target = <&usbdrd_dwc3_0>;
		__overlay__ {
			dr_mode = "peripheral";
			compatible = "snps,dwc3";
			reg = <0x0 0xfe800000 0x0 0x100000>;
			phys = <&tcphy0_usb3>;
			phy-names = "usb3-phy";
			phy_type = "utmi_wide";
			snps,dis_enblslpm_quirk;
			snps,dis-u2-freeclk-exists-quirk;
			snps,dis_u2_susphy_quirk;
			snps,dis-del-phy-power-chg-quirk;
			snps,xhci-slow-suspend-quirk;
		};
	};
};
